<Window x:Class="Project.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Project.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="Specification Save / Load"
        Height="600"
        Width="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Recursive tree template: inner nodes expand into Children, leaf nodes show an input control -->
        <HierarchicalDataTemplate DataType="{x:Type vm:SpecNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding DisplayName}"
                           Width="140"
                           VerticalAlignment="Center"/>
                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsStringLeaf, Converter={StaticResource BoolToVis}}"/>
                <ComboBox ItemsSource="{Binding EnumValues}"
                          SelectedItem="{Binding SelectedEnumValue}"
                          Width="200"
                          VerticalAlignment="Center"
                          Visibility="{Binding IsEnumLeaf, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Save / Load panels -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Save" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Serial Code"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding SerialCode, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Saved Serials"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding SerialCodes}"
                              SelectedItem="{Binding SelectedSerialForSave}"/>

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}">Save</Button>
                        <Button Width="100" Command="{Binding RefreshCommand}">Refresh List</Button>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Load" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Select Serial"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding SerialCodes}"
                              SelectedItem="{Binding SelectedSerialForLoad}"/>

                    <Button Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left"
                            Command="{Binding LoadCommand}">Load</Button>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Specification tree (all nodes expanded by default, collapsible) -->
        <GroupBox Grid.Row="1" Header="Specification" Padding="12">
            <TreeView ItemsSource="{Binding SpecNodes}" BorderThickness="0">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </GroupBox>

        <TextBlock Grid.Row="2"
                   Margin="0,16,0,0"
                   Foreground="DarkSlateBlue"
                   TextWrapping="Wrap"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</Window>
